{
  "schema_version": 1,
  "version_file": "VERSION",
  "release_notes": [
    "CHANGELOG.md",
    "CHANGELOG.en.md"
  ],
  "build": [
    {
      "id": "catalog-source-build",
      "argv": [
        "python",
        "tools/build_catalog_package.py",
        "--repo",
        ".",
        "--output-dir",
        "dist",
        "--check-reproducible"
      ],
      "cwd": ".",
      "timeout_seconds": 180
    }
  ],
  "tests": [
    {
      "id": "catalog-tests",
      "argv": [
        "python",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-v"
      ],
      "cwd": ".",
      "timeout_seconds": 300
    },
    {
      "id": "skill-tests",
      "argv": [
        "python",
        "-m",
        "unittest",
        "discover",
        "-s",
        "skills/microversion-release/tests",
        "-v"
      ],
      "cwd": ".",
      "timeout_seconds": 300
    }
  ]
}
